# Copier vers .env (jamais committé). Guillemets simples conseillés si une valeur contient !, $ ou #.
# En production, ces variables vivent dans Vercel (Production / Preview / Development).

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.local
# Obligatoire en production, une valeur différente par environnement.
# Générer : uv run python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
# Anciennes clés (rotation), séparées par des virgules.
SECRET_KEY_FALLBACKS=
# Domaine de production .vercel.app (jamais l'URL d'un déploiement), sans le schéma pour ALLOWED_HOSTS.
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Base de données (Supabase) ---
# Application : pooler transactionnel, port 6543, sslmode=require.
DATABASE_URL=postgres://cookup:cookup@localhost:5433/cookup
# Migrations : connexion directe ou pooler en mode session (port 5432).
DATABASE_DIRECT_URL=postgres://cookup:cookup@localhost:5433/cookup

# --- Administration Django ---
# Chemin non standard (ex. gestion-xxxx/). Vide = administration désactivée (production).
ADMIN_PATH=admin/

# --- Tâches planifiées ---
# Chaîne aléatoire d'au moins 32 caractères ; Vercel l'envoie en Bearer.
CRON_SECRET=

# --- Sources de recettes (jalons M2 et M5) ---
# Adresse de contact placée dans le User-Agent (obligatoire pour tout accès réseau).
SOURCES_CONTACT=
# Domaines autorisés pour l'import par URL, séparés par des virgules.
SOURCES_ALLOWED_DOMAINS=marmiton.org
# Import automatique hebdomadaire depuis Marmiton (respecte robots.txt, 1 requête/seconde).
SOURCE_MARMITON_ENABLED=false
SOURCE_IMPORT_WEEKLY_QUOTA=40
SOURCE_QUERIES_PER_WEEK=4
SOURCE_BATCH_SECONDS=40
SOURCE_MOULINEX_ENABLED=false

# --- IA facultative (jalon M7) ---
AI_RECIPES_ENABLED=false
ANTHROPIC_API_KEY=

# --- E-mails (jalon M1, fournisseur à choisir : Resend ou Brevo) ---
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Divers ---
# Durée de validité des invitations en jours ; 0 = elles n'expirent pas.
INVITATION_TTL_DAYS=0
SENTRY_DSN=
